{
  "manifest_version": 3,
  "name": "Text-to-Voice Reader",
  "version": "1.0.0",
  "description": "Read any web page text aloud using OpenAI's Text-to-Speech API. High-quality voice synthesis for articles, books, and more.",

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "offscreen",
    "contextMenus"
  ],

  "host_permissions": [
    "https://api.openai.com/*"
  ],

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "options_page": "src/options/options.html",

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content-script.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
